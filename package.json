{
  "name": "emp-management",
  "version": "1.0.0",
  "private": true,
  "description": "Single-admin internal tool for tracking monthly salary payments",
  "scripts": {
    "dev": "npm run db:migrate && next dev",
    "build": "prisma generate && next build",
    "start": "npm run db:migrate && next start -H ${BIND_HOST:-127.0.0.1}",
    "db:migrate": "prisma migrate deploy && node scripts/secure-db.mjs",
    "db:secure": "node scripts/secure-db.mjs",
    "docker:publish": "docker/publish.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "15.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
