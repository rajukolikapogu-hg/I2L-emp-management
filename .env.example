# Absolute or schema-relative path to the SQLite file. Relative paths resolve from prisma/.
DATABASE_URL="file:../data/emp.db"

# Secret used to sign the session cookie. REQUIRED in production, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# REQUIRED in production: exactly "true" or "false" (anything else stops the server at startup).
# Use "true" when the app is served over HTTPS (e.g. behind a TLS reverse proxy).
COOKIE_SECURE="false"

# BIND_HOST: interface `npm start` binds to. Defaults to 127.0.0.1 (localhost only). Set it to
# a LAN address to serve a trusted local network; never a public interface or 0.0.0.0.
# It is read by the shell running `npm start`, NOT from this file: set it in the process
# environment (e.g. the systemd unit), as in `BIND_HOST=192.168.1.10 npm start`.
# (HOSTNAME is not read by `next start`.)
