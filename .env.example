# Absolute or schema-relative path to the SQLite file. Relative paths resolve from prisma/.
DATABASE_URL="file:../data/emp.db"

# Secret used to sign the session cookie. REQUIRED in production, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Set to "true" only when the app is served over HTTPS (e.g. behind a TLS reverse proxy).
COOKIE_SECURE="false"
